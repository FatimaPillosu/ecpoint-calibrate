# webpack 4 uses an MD4 hash that OpenSSL 3 (Node 17+) rejects; the legacy
# provider re-enables it so `npm run build` works on modern Node, locally and in CI.
node-options=--openssl-legacy-provider

# react-datasheet@1.4.8 declares an impossible peer dependency (prop-types>=16,
# which never existed). Modern npm (v7+) treats this as a hard error; legacy mode
# ignores peer conflicts so `npm install` succeeds. The installed tree works fine.
legacy-peer-deps=true
